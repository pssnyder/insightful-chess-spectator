# Environment Configuration for Chess Spectator

# Debug Settings
DEBUG=false
LOG_LEVEL=INFO

# Data Directories
DATA_DIR=./data
MODELS_DIR=./models

# Anti-Cheat Configuration
MIN_ANALYSIS_DELAY=30.0
SPECTATOR_MODE_ONLY=true
RATE_LIMIT_REQUESTS=10
REQUIRE_WINDOW_DETECTION=true
BLOCK_LIVE_GAMES=true

# Computer Vision Settings
BOARD_DETECTION_CONFIDENCE=0.8
PIECE_DETECTION_CONFIDENCE=0.7
SQUARE_SIZE_MIN=30
SQUARE_SIZE_MAX=100
COLOR_TOLERANCE=30

# Chess Analysis Settings
STOCKFISH_DEPTH=15
STOCKFISH_TIME=1.0
MAX_VARIATIONS=3
EVALUATION_THRESHOLD=0.5

# Firebase Configuration (Fill in your details)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CREDENTIALS_PATH=./config/firebase-credentials.json
FIREBASE_COLLECTION=chess_analysis

# UI Configuration
WINDOW_WIDTH=1200
WINDOW_HEIGHT=800
UPDATE_INTERVAL=1000
COMMENTARY_MAX_LENGTH=500